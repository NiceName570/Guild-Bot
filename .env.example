# Keep the real .env private; never commit tokens or credentials.
DISCORD_TOKEN=
# Application metadata (not needed for the gateway bot's login).
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
# Your own Discord user ID. Only this person can configure or assign managers.
BOT_OWNER_ID=
# The OTHER clan's server ID, not your personal server.
CLAN_GUILD_ID=
AWS_REGION=us-east-2
# Optional: absolute path on durable storage. Default: guild.db beside bot.py.
# CLAN_DB_PATH=/opt/guild-bot/guild.db
